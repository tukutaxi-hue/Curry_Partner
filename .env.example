# Copy to apps/api/.env for local development.
# These values are placeholders. Do not put production credentials in this file.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# Runtime role. Subject to row-level security. Not a superuser.
DATABASE_URL=postgresql://curry_app:replace-me@127.0.0.1:5432/curry_partner

# Migration and seed role. Owns tables and bypasses row-level security.
MIGRATION_DATABASE_URL=postgresql://curry_owner:replace-me@127.0.0.1:5432/curry_partner

# Test databases used by `pnpm test`.
TEST_DATABASE_URL=postgresql://curry_app:replace-me@127.0.0.1:5432/curry_partner_test
TEST_MIGRATION_DATABASE_URL=postgresql://curry_owner:replace-me@127.0.0.1:5432/curry_partner_test

# At least 32 characters. Generate a unique value per environment.
ACCESS_TOKEN_SECRET=replace-me-with-a-random-string-of-32-plus-characters

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

COOKIE_SECURE=false
ENABLE_SCHEDULER=true

# Local bootstrap only. scripts/init-db.sh reads these when creating roles.
CURRY_APP_PASSWORD=replace-me
CURRY_OWNER_PASSWORD=replace-me

# Used by the demo seed. Refused when NODE_ENV=production.
SEED_ADMIN_PHONE=+919800000001
SEED_ADMIN_PASSWORD=DemoAdmin-2026
SEED_HOMEMAKER_PHONE=+919800000002
SEED_HOMEMAKER_PASSWORD=DemoHome-2026
SEED_INVITED_PHONE=+919800000003
SEED_INVITED_PASSWORD=DemoTemp-2026

# Homemaker app. Use http://10.0.2.2:4000 on the Android emulator.
# Leave empty when the web app is served on the same site as the API.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Vercel only. Set ALLOW_DEMO_SEED=true to load the DEMO fixtures during deploy.
# Also set COOKIE_SECURE=true and ENABLE_SCHEDULER=false on Vercel.
ALLOW_DEMO_SEED=false
